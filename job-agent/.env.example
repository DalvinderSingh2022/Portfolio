# ---------------------------------------------------------------------------
# Job Agent configuration. Copy to `.env` and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# If left empty, the agent falls back to an in-memory store (great for Phase 1
# / mock-data runs, but data is not persisted between runs).
DATABASE_URL=

# --- LLM (Phase 3 — optional; the rule-based pipeline runs without it) --------
# Provider: "openai" | "anthropic" | "mock" (mock = deterministic, no network)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
# Master switch for the AI matching stage. Off by default in Phase 1.
ENABLE_LLM_MATCHING=false

# --- Discovery ----------------------------------------------------------------
JOB_SEARCH_INTERVAL_HOURS=6
MIN_MATCH_SCORE=70
# Cap on how many jobs are forwarded to the (paid) LLM stage per run.
LLM_MAX_JOBS=30

# --- Source toggles -----------------------------------------------------------
# The mock source is always available for local development.
ENABLE_MOCK=true
ENABLE_LINKEDIN=false
ENABLE_INDEED=false
ENABLE_NAUKRI=false
ENABLE_WELLFOUND=false
ENABLE_GLASSDOOR=false
# Company career pages via public ATS boards (Greenhouse/Lever). When true, the
# agent pulls from the boards listed in data/sources/companies.json.
ENABLE_COMPANY_CAREERS=false
COMPANIES_CONFIG_PATH=./data/sources/companies.json

# --- Notifications ------------------------------------------------------------
ENABLE_EMAIL_NOTIFICATIONS=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM=
NOTIFY_TO=

# --- Observability ------------------------------------------------------------
LOG_LEVEL=info
# Pretty-print logs for local dev (true), or emit JSON (false) for production.
LOG_PRETTY=true

# --- Paths (override only if you move the data files) -------------------------
CANDIDATE_PROFILE_PATH=./data/candidate/profile.json
CANDIDATE_RESUME_PATH=./data/candidate/resume.md
SEARCH_CONFIG_PATH=./data/search/search.config.json
