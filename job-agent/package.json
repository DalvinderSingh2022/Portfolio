{
  "name": "job-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Job Discovery & Matching Agent — discovers, normalizes, deduplicates, matches and ranks software-development jobs from multiple platforms.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "jobs:search": "tsx src/index.ts search",
    "jobs:match": "tsx src/index.ts match",
    "jobs:daily": "tsx src/index.ts daily",
    "jobs:stats": "tsx src/index.ts stats",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.7",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
